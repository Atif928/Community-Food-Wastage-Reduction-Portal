{
  "name": "food-wastage-portal-server",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the Community Food Wastage Reduction Portal (Express + PostgreSQL/Neon).",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:create": "node scripts/runSql.js schema",
    "db:seed": "node scripts/runSql.js seed",
    "db:reset": "node scripts/runSql.js schema && node scripts/runSql.js seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.1",
    "nodemailer": "^6.9.13",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
