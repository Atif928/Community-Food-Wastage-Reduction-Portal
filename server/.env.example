# =============================================================================
# Server environment template.
# Copy to server/.env and fill in real values:  cp .env.example .env
# =============================================================================

# --- Server -----------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Comma separated list of allowed browser origins (CORS).
CLIENT_ORIGIN=http://localhost:5173
# Public base URL of this API, used to build absolute image URLs in emails.
API_BASE_URL=http://localhost:5000

# --- PostgreSQL / Neon -------------------------------------------------------
# Preferred: paste the connection string from your provider (Neon, Render,
# Railway, Supabase...). Neon strings look like:
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Use the "-pooler" host for the app (serverless friendly).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/food_waste_portal?sslmode=require
# TLS is enabled automatically when the URL contains ?sslmode=require.
# Set PGSSL=true to force it (required by most managed providers).
PGSSL=false
# Managed providers use certificates signed by their own CA, so verification is
# off by default. Set to "true" if you have the CA configured locally.
PGSSL_REJECT_UNAUTHORIZED=false
PG_POOL_MAX=10
PG_DEBUG=false

# Used only when DATABASE_URL is empty (local PostgreSQL).
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=food_waste_portal

# --- JWT / auth -------------------------------------------------------------
# Use a long random string (32+ chars). Changing it invalidates all tokens.
JWT_SECRET=replace-with-a-long-random-secret-string
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

# --- Uploads (Multer local storage) -----------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# --- Notification engine ----------------------------------------------------
# Radius (km) used to find NGOs near a newly posted donation.
NOTIFY_RADIUS_KM=10
# Set to "true" to skip Nodemailer (emails are logged to the console instead).
EMAIL_DISABLED=true

# --- SMTP (Nodemailer) ------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM="Community Food Portal <no-reply@foodportal.local>"

# --- Google Maps (used by the client; mirrored here for email/map links) ----
GOOGLE_MAPS_API_KEY=your-google-maps-javascript-api-key

# --- Firebase Storage (OPTIONAL) --------------------------------------------
# Leave STORAGE_DRIVER=local to use Multer disk storage.
# Set to "firebase" and fill the block below to upload images to Firebase.
STORAGE_DRIVER=local
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
