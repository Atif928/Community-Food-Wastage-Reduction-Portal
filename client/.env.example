# Client environment template.
# Copy to client/.env and fill in real values:  cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# The Google Maps JavaScript API key is ALWAYS visible to users, so restrict it
# in Google Cloud Console by HTTP referrer (e.g. http://localhost:5173/*).

# Google Maps JavaScript API key (Maps JavaScript API + Geocoding API enabled)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-javascript-api-key

# Base URL of the Express API (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000/api

# How often (ms) the dashboard polls for new notifications
VITE_NOTIFICATION_POLL_MS=30000
